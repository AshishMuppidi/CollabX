# ==========================================
# CollabX 2.0 Environment Configuration
# ==========================================

# -----------------
# Server & Network
# -----------------
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# -----------------
# Security & Tokens
# -----------------
# 32+ character secret for signing room access tokens (auto-generated if empty)
COLLABX_SECURITY_TOKEN_SECRET=

# -----------------
# MySQL Database
# -----------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/collabx_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# -----------------
# Judge0 Code Execution
# -----------------
# Public CE endpoint or self-hosted Judge0 instance:
JUDGE0_API_URL=https://ce.judge0.com

# Optional credentials (leave empty if using unauthenticated public CE instance)
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Polling and timeout configurations
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_MAX_POLL_ATTEMPTS=25
JUDGE0_FETCH_TIMEOUT_MS=15000

# -----------------
# Frontend Configuration (Vite)
# -----------------
# Leave empty for Vite dev proxy, or set explicitly for production:
VITE_API_URL=
VITE_SOCKET_URL=
VITE_PUBLIC_APP_URL=
